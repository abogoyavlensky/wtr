(ns wtr.completion-test
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [tiny-cli.completion :as tc]
            [wtr.completion :as completion]))

;; Completion behavior (subcommands, flags, worktree names, shells, scripts) is
;; now provided by tiny-cli's built-in engine. These tests drive that engine
;; against a wtr-shaped mirror app, re-confirming the built-in works for wtr —
;; the app-specific bit is the :complete fn on the worktree-name positionals.
;; wtr keeps only the pure worktree-names derivation, tested at the bottom.

;; The worktree-name :complete fns are fixtures here so the engine wiring is
;; what's under test. `run-switch-names` mirrors
;; wtr.completion/worktree-name-candidates: one default-branch token (the repo's
;; actual default, here master) plus the non-main worktree names.
;; `remove-names` mirrors wtr.completion/removable-worktree-name-candidates:
;; names only, since main/master are protected from removal.
(def run-switch-names (constantly ["master" "feat-x" "feature/bar"]))
(def remove-names (constantly ["feat-x" "feature/bar"]))

(def app
  {:name "wtr"
   :opts [{:key :base-dir
           :long "base-dir"
           :value? true}]
   :commands [{:name "list"}
              {:name "create"
               :args [{:key :name}]
               :opts [{:key :from
                       :long "from"
                       :value? true}]}
              {:name "run"
               :args [{:key :name
                       :complete run-switch-names}]
               :variadic {:key :cmd}}
              {:name "switch"
               :args [{:key :name
                       :complete run-switch-names}]}
              {:name "remove"
               :args [{:key :name
                       :complete remove-names}]
               :opts [{:key :force
                       :long "force"}]}
              {:name "config"}]})

;; The hidden `completion` command is injected by tiny-cli, not declared above.
(def iapp (tc/install-command app))

(deftest candidates-subcommands
  (testing "empty input lists every command plus completion and help"
    (is (= ["list" "create" "run" "switch" "remove" "config" "completion" "help"]
           (tc/candidates iapp [] ""))))

  (testing "prefix filters command names"
    (is (= ["switch"] (tc/candidates iapp [] "sw"))))

  (testing "help completes command names"
    (is (= ["config" "completion"]
           (tc/candidates iapp ["help"] "co"))))

  (testing "help with an argument already given completes nothing"
    (is (= [] (tc/candidates iapp ["help" "list"] "")))))

(deftest candidates-flags
  (testing "root flags"
    (is (= ["--base-dir" "--help" "--version"]
           (tc/candidates iapp [] "-"))))

  (testing "command flags include globals and the command's own"
    (is (= ["--base-dir" "--force" "--help"]
           (tc/candidates iapp ["remove"] "-"))))

  (testing "flags still complete after a positional on a non-variadic command"
    (is (= ["--base-dir" "--force" "--help"]
           (tc/candidates iapp ["remove" "feat-x"] "-")))
    (is (= ["--base-dir" "--help"]
           (tc/candidates iapp ["switch" "feat-x"] "-"))))

  (testing "a flag awaiting its value completes nothing"
    (is (= [] (tc/candidates iapp ["--base-dir"] "")))
    (is (= [] (tc/candidates iapp ["create" "--from"] "")))))

(deftest candidates-worktree-names
  (testing "run/switch complete the default-branch token plus worktree names"
    (is (= ["master" "feat-x" "feature/bar"]
           (tc/candidates iapp ["switch"] "")))
    (is (= ["feature/bar"]
           (tc/candidates iapp ["run"] "feature"))))

  (testing "remove completes only worktree names, never main/master"
    (is (= ["feat-x" "feature/bar"]
           (tc/candidates iapp ["remove"] "")))
    (is (= ["feat-x" "feature/bar"]
           (tc/candidates iapp ["remove"] "feat"))))

  (testing "a flag does not consume the name slot"
    (is (= ["feat-x" "feature/bar"]
           (tc/candidates iapp ["remove" "--force"] ""))))

  (testing "global flag with value before the command still resolves it"
    (is (= ["switch"]
           (tc/candidates iapp ["--base-dir" "/x"] "sw"))))

  (testing "after the worktree name, run completes nothing (user command)"
    (is (= [] (tc/candidates iapp ["run" "feat-x"] "")))
    (is (= [] (tc/candidates iapp ["run" "feat-x" "git"] "chec"))))

  (testing "second positional of switch/remove completes nothing"
    (is (= [] (tc/candidates iapp ["switch" "feat-x"] "")))))

(deftest candidates-misc
  (testing "completion command completes shell names"
    (is (= ["bash" "zsh" "fish"]
           (tc/candidates iapp ["completion"] "")))
    (is (= ["zsh"]
           (tc/candidates iapp ["completion"] "z")))
    (is (= [] (tc/candidates iapp ["completion" "bash"] ""))))

  (testing "create's positional is a new name: nothing to complete"
    (is (= [] (tc/candidates iapp ["create"] ""))))

  (testing "unknown command completes nothing"
    (is (= [] (tc/candidates iapp ["bogus"] "")))))

(deftest completion-scripts
  (testing "tiny-cli generates a wtr script calling __complete for every shell"
    (doseq [shell ["bash" "zsh" "fish"]]
      (let [script (tc/script {:name "wtr"} shell)]
        (is (not (str/blank? script)))
        (is (str/includes? script "__complete")))))

  (testing "unknown shell yields nil"
    (is (nil? (tc/script {:name "wtr"} "powershell")))))

(def wts
  [{:path "/Users/u/Projects/wtr"
    :branch "refs/heads/master"}
   {:path "/Users/u/worktrees/wtr/feat-x"
    :branch "refs/heads/feat-x"}
   {:path "/Users/u/worktrees/wtr/feature/bar"
    :branch "refs/heads/feature/bar"}
   {:path "/elsewhere/odd-one"
    :branch "refs/heads/odd"}])

(deftest worktree-names-derivation
  (testing "strips base prefix, keeping namespaced names intact"
    (is (= ["feat-x" "feature/bar" "odd-one"]
           (completion/worktree-names wts "/Users/u/worktrees/wtr/"))))

  (testing "falls back to basename without a base prefix"
    (is (= ["feat-x" "bar" "odd-one"]
           (completion/worktree-names wts nil))))

  (testing "main worktree is never listed"
    (is (= [] (completion/worktree-names [(first wts)] nil)))))

(deftest default-branch-token-derivation
  (testing "attached main worktree yields its own branch token"
    (is (= "master" (completion/default-branch-token {:branch "refs/heads/master"})))
    (is (= "main" (completion/default-branch-token {:branch "refs/heads/main"})))))

(deftest removable-names-drops-protected-aliases
  (testing "exact main/master are dropped; namespaced names are kept"
    (is (= ["feat-x" "feature/bar" "feature/main"]
           (completion/removable-names
             ["feat-x" "main" "feature/bar" "master" "feature/main"]))))
  (testing "leaves ordinary names untouched"
    (is (= ["feat-x" "feature/bar"]
           (completion/removable-names ["feat-x" "feature/bar"])))))
