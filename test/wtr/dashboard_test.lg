(ns wtr.dashboard-test
  (:require [clojure.test :refer [deftest is testing]]
            [wtr.dashboard :as dashboard]))

(defn- scripted
  "Read-key fn that returns the scripted messages one by one, then nil (EOF)."
  [msgs]
  (let [q (atom (seq msgs))]
    (fn []
      (let [m (first @q)]
        (swap! q rest)
        m))))

(deftest result->intent-maps-results
  (testing "enter selects → run intent"
    (is (= [:run "feat-x"]
           (dashboard/result->intent {:type :select
                                      :item "feat-x"
                                      :index 1}))))
  (testing "run action key → run intent"
    (is (= [:run "feat-x"]
           (dashboard/result->intent
             {:type :action
              :action :run
              :item "feat-x"
              :index 1}))))
  (testing "switch action key → switch intent"
    (is (= [:switch "feat-x"]
           (dashboard/result->intent
             {:type :action
              :action :switch
              :item "feat-x"
              :index 1}))))
  (testing "remove action key → remove intent"
    (is (= [:remove "feat-x"]
           (dashboard/result->intent
             {:type :action
              :action :remove
              :item "feat-x"
              :index 1}))))
  (testing "cancel → cancel intent"
    (is (= :cancel (dashboard/result->intent {:type :cancel})))))

(deftest pick-acts-on-selection
  (testing "arrow-down then enter runs the highlighted worktree"
    (let [ran (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :run-fn (fn [name] (reset! ran name))
                        :screen false
                        :read-key-fn (scripted [:down :enter])
                        :render-fn (fn [_] nil)})
      (is (= "feat-x" @ran))))

  (testing "the run action key runs the highlighted worktree"
    (let [ran (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :run-fn (fn [name] (reset! ran name))
                        :screen false
                        :read-key-fn (scripted ["r"])
                        :render-fn (fn [_] nil)})
      (is (= "main" @ran))))

  (testing "the switch action key switches the highlighted worktree"
    (let [switched (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :switch-fn (fn [name] (reset! switched name))
                        :screen false
                        :read-key-fn (scripted ["s"])
                        :render-fn (fn [_] nil)})
      (is (= "main" @switched))))

  (testing "the remove action key removes after confirmation"
    (let [removed (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :remove-fn (fn [name] (reset! removed name))
                        :screen false
                        :read-key-fn (scripted [:down "d" "y"])
                        :render-fn (fn [_] nil)})
      (is (= "feat-x" @removed))))

  (testing "cancelling the remove confirmation removes nothing"
    (let [removed (atom :untouched)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :remove-fn (fn [name] (reset! removed name))
                        :screen false
                        :read-key-fn (scripted [:down "d" "n"])
                        :render-fn (fn [_] nil)})
      (is (= :untouched @removed))))

  (testing "cancelling runs nothing"
    (let [ran (atom :untouched)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :run-fn (fn [name] (reset! ran name))
                        :screen false
                        :read-key-fn (scripted [:esc])
                        :render-fn (fn [_] nil)})
      (is (= :untouched @ran)))))
