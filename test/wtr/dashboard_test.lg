(ns wtr.dashboard-test
  (:require [clojure.test :refer [deftest is testing]]
            [wtr.dashboard :as dashboard]))

(defn- scripted
  "Read-key fn that returns the scripted messages one by one, then nil (EOF)."
  [msgs]
  (let [q (atom (seq msgs))]
    (fn []
      (let [m (first @q)]
        (swap! q rest)
        m))))

(deftest pick-runs-on-enter
  (testing "enter opens (runs) the highlighted worktree"
    (let [ran (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :run-fn (fn [name] (reset! ran name))
                        :screen false
                        :read-key-fn (scripted [:down :enter])
                        :render-fn (fn [_] nil)})
      (is (= "feat-x" @ran)))))

(deftest pick-acts-in-loop
  (testing "the switch action key switches, then stays in the loop"
    (let [switched (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :switch-fn (fn [event]
                                     (reset! switched (:item event))
                                     {:status "switched"})
                        :screen false
                        :read-key-fn (scripted ["s" "q"])
                        :render-fn (fn [_] nil)})
      (is (= "main" @switched))))

  (testing "the remove action key removes after confirmation, then stays"
    (let [removed (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :remove-fn (fn [event]
                                     (reset! removed (:item event))
                                     {:items ["main"]
                                      :status "removed"})
                        :screen false
                        :read-key-fn (scripted [:down "d" "y" "q"])
                        :render-fn (fn [_] nil)})
      (is (= "feat-x" @removed))))

  (testing "cancelling the remove confirmation removes nothing"
    (let [removed (atom :untouched)]
      (dashboard/pick! {:items ["main" "feat-x"]
                        :remove-fn (fn [event]
                                     (reset! removed (:item event))
                                     {:items ["main"]
                                      :status "removed"})
                        :screen false
                        :read-key-fn (scripted [:down "d" "n" "q"])
                        :render-fn (fn [_] nil)})
      (is (= :untouched @removed)))))

(deftest pick-create
  (testing "c creates, then opens a shell in the new worktree"
    (let [created (atom false)
          ran (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x" "new-wt"]
                        :create-fn (fn [] (reset! created true) {:name "new-wt"})
                        :run-fn (fn [name] (reset! ran name))
                        :screen false
                        :read-key-fn (scripted ["c"])
                        :render-fn (fn [_] nil)})
      (is (= true @created))
      (is (= "new-wt" @ran))))

  (testing "cancelling create returns to the list at the top"
    (let [ran (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x" "new-wt"]
                        :create-fn (fn [] {})
                        :run-fn (fn [name] (reset! ran name))
                        :screen false
                        :read-key-fn (scripted ["c" :enter])
                        :render-fn (fn [_] nil)})
      (is (= "main" @ran))))

  (testing "a failed create shows its error as a status and stays at the top"
    (let [frames (atom [])
          ran (atom nil)]
      (dashboard/pick! {:items ["main" "feat-x" "new-wt"]
                        :create-fn (fn [] {:status "create failed: boom"})
                        :run-fn (fn [name] (reset! ran name))
                        :screen false
                        :read-key-fn (scripted ["c" :enter])
                        :render-fn (fn [s] (swap! frames conj s))})
      (is (= "main" @ran))
      (is (some (fn [f] (re-find #"boom" f)) @frames)))))
