(ns wtr.git-test
  (:require [clojure.string :as str]
            [os :as os]
            [test :refer [deftest is testing run-tests]]
            [wtr.git :as git]))

(deftest main-worktree-path-returns-absolute-path
  (let [path (git/main-worktree-path)]
    (is (string? path))
    (is (str/starts-with? path "/"))))

(deftest branch-exists-detects-existing-branch
  (testing "an existing local branch is detected (works with detached HEAD)"
    (let [out (:out (os/sh "git" "for-each-ref" "refs/heads"
                           "--format=%(refname:short)"))
          name (first (str/split (str/trim out) #"\n"))]
      (is (git/branch-exists? name)))))

(deftest branch-exists-returns-false-for-missing
  (is (= false (git/branch-exists? "wtr-test-nonexistent-xyz-987654"))))
