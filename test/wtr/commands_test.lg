(ns wtr.commands-test
  (:require [clojure.test :refer [deftest is testing]]
            [wtr.commands :as cmds]))

(deftest basename-extracts-last-segment
  (testing "simple absolute path"
    (is (= "wtr" (cmds/basename "/Users/andrew/Projects/wtr"))))
  (testing "trailing slash"
    (is (= "wtr" (cmds/basename "/Users/andrew/Projects/wtr/"))))
  (testing "root segment"
    (is (= "a" (cmds/basename "/a")))))

(deftest path-construction-pattern
  (testing "base/project/name string concat matches the spec"
    (let [base "/Users/u/Projects/worktrees"
          project "wtr"
          name "feature-x"]
      (is (= "/Users/u/Projects/worktrees/wtr/feature-x"
             (str base "/" project "/" name))))))

(def sample-wts
  [{:path "/Users/u/Projects/wtr"}
   {:path "/Users/u/Projects/worktrees/wtr/feat-x"}
   {:path "/Users/u/Projects/worktrees/wtr/bugfix"}
   {:path "/Users/u/Projects/worktrees/wtr/feature/bar"}])

(deftest resolve-worktree-path-aliases-main
  (testing "master resolves to the main (first) worktree"
    (is (= "/Users/u/Projects/wtr"
           (cmds/resolve-worktree-path sample-wts "master"))))
  (testing "main resolves to the main (first) worktree"
    (is (= "/Users/u/Projects/wtr"
           (cmds/resolve-worktree-path sample-wts "main")))))

(deftest resolve-worktree-path-by-name
  (testing "matches a worktree by its directory name"
    (is (= "/Users/u/Projects/worktrees/wtr/feat-x"
           (cmds/resolve-worktree-path sample-wts "feat-x")))
    (is (= "/Users/u/Projects/worktrees/wtr/bugfix"
           (cmds/resolve-worktree-path sample-wts "bugfix"))))

  (testing "matches a namespaced name by path suffix (feature/bar)"
    (is (= "/Users/u/Projects/worktrees/wtr/feature/bar"
           (cmds/resolve-worktree-path sample-wts "feature/bar")))))

(deftest resolve-worktree-path-not-found
  (testing "returns nil when nothing matches"
    (is (nil? (cmds/resolve-worktree-path sample-wts "nope")))))

(deftest run-command-mode-classifies-commands
  (testing "no command opens an interactive shell"
    (is (= :interactive-shell
           (cmds/run-command-mode "/tmp" []))))

  (testing "an executable command uses direct exec"
    (is (= :direct
           (cmds/run-command-mode "/tmp" ["sh" "-c" "true"]))))

  (testing "a command with both builtin and executable forms stays direct"
    (is (= :direct
           (cmds/run-command-mode "/tmp" ["pwd"])))
    (is (= :direct
           (cmds/run-command-mode "/tmp" ["true"]))))

  (testing "a shell builtin falls back to the user's shell"
    (is (= :shell-command
           (cmds/run-command-mode "/tmp" ["cd"]))))

  (testing "an unknown command falls back to the user's shell"
    (is (= :shell-command
           (cmds/run-command-mode
             "/tmp" ["definitely-not-an-executable-for-wtr-test"])))))

(deftest run-exec-argv-builds-command-lines
  (testing "interactive shell mode starts the user's shell after cd"
    (is (= ["sh" "-c" "cd \"$1\" || exit 1; shift; exec \"$@\""
            "sh" "/tmp/wt" "/bin/zsh" "-i"]
           (cmds/run-exec-argv
             "/tmp/wt" "/bin/zsh" :interactive-shell []))))

  (testing "interactive shell mode ignores a nil command (create --sh passes nil)"
    (is (= ["sh" "-c" "cd \"$1\" || exit 1; shift; exec \"$@\""
            "sh" "/tmp/wt" "/bin/zsh" "-i"]
           (cmds/run-exec-argv
             "/tmp/wt" "/bin/zsh" :interactive-shell nil))))

  (testing "direct mode keeps the existing exec wrapper"
    (is (= ["sh" "-c" "cd \"$1\" || exit 1; shift; exec \"$@\""
            "sh" "/tmp/wt" "sh" "-c" "pwd"]
           (cmds/run-exec-argv
             "/tmp/wt" "/bin/zsh" :direct ["sh" "-c" "pwd"]))))

  (testing "shell command mode uses an interactive shell so functions load"
    (is (= ["/bin/zsh" "-ic" "cd \"$1\" || exit 1; shift; \"$@\""
            "wtr-shell" "/tmp/wt" "lmcx" "arg"]
           (cmds/run-exec-argv
             "/tmp/wt" "/bin/zsh" :shell-command ["lmcx" "arg"])))))

(def switch-wts
  [{:path "/Users/u/Projects/wtr"
    :branch "refs/heads/master"
    :head "aaaaaaa1111"}
   {:path "/Users/u/Projects/worktrees/wtr/feat-x"
    :branch "refs/heads/feat-x"
    :head "8a1b2c3def4"}
   {:path "/Users/u/Projects/worktrees/wtr/feature/bar"
    :branch "refs/heads/feature/bar"
    :head "ccccccc3333"}
   {:path "/Users/u/Projects/worktrees/wtr/loose"
    :detached? true
    :head "ddddddd4444"}])

(deftest resolve-switch-target-reattach
  (testing "master is a reserved reattach token"
    (is (= {:mode :reattach
            :ref "master"}
           (cmds/resolve-switch-target switch-wts "master"))))
  (testing "main is a reserved reattach token"
    (is (= {:mode :reattach
            :ref "main"}
           (cmds/resolve-switch-target switch-wts "main")))))

(deftest resolve-switch-target-detach
  (testing "matching worktree detaches at its branch tip (refs/heads/ stripped)"
    (is (= {:mode :detach
            :ref "feat-x"
            :label "feat-x"
            :sha "8a1b2c3def4"}
           (cmds/resolve-switch-target switch-wts "feat-x"))))
  (testing "namespaced name resolves by path suffix"
    (is (= {:mode :detach
            :ref "feature/bar"
            :label "feature/bar"
            :sha "ccccccc3333"}
           (cmds/resolve-switch-target switch-wts "feature/bar"))))
  (testing "a detached worktree (no :branch) falls back to its head sha"
    (is (= {:mode :detach
            :ref "ddddddd4444"
            :label "loose"
            :sha "ddddddd4444"}
           (cmds/resolve-switch-target switch-wts "loose")))))

(deftest resolve-switch-target-not-found
  (testing "returns nil when no worktree matches"
    (is (nil? (cmds/resolve-switch-target switch-wts "nope")))))

(deftest main-return-branch-from-attached-main
  (testing "uses the attached main worktree's branch (refs/heads/ stripped)"
    (is (= "main" (cmds/main-return-branch {:branch "refs/heads/main"})))
    (is (= "master" (cmds/main-return-branch {:branch "refs/heads/master"})))))

(def remove-wts
  [{:path "/Users/u/Projects/wtr"
    :branch "refs/heads/master"
    :head "aaaaaaa1111"}
   {:path "/Users/u/Projects/worktrees/wtr/feat-x"
    :branch "refs/heads/feat-x"
    :head "8a1b2c3def4"}
   {:path "/Users/u/Projects/worktrees/wtr/feature/bar"
    :branch "refs/heads/feature/bar"
    :head "ccccccc3333"}
   {:path "/Users/u/Projects/worktrees/wtr/loose"
    :detached? true
    :head "ddddddd4444"}])

(deftest resolve-remove-target-main-guard
  (testing "master and main are reserved main worktree aliases"
    (is (= {:main? true}
           (cmds/resolve-remove-target remove-wts "master")))
    (is (= {:main? true}
           (cmds/resolve-remove-target remove-wts "main"))))
  (testing "a suffix match against the main worktree is refused as main"
    (is (= {:main? true}
           (cmds/resolve-remove-target remove-wts "wtr")))))

(deftest resolve-remove-target-non-main-worktrees
  (testing "matching worktree returns path and stripped branch"
    (is (= {:path "/Users/u/Projects/worktrees/wtr/feat-x"
            :branch "feat-x"}
           (cmds/resolve-remove-target remove-wts "feat-x"))))
  (testing "namespaced name resolves by path suffix"
    (is (= {:path "/Users/u/Projects/worktrees/wtr/feature/bar"
            :branch "feature/bar"}
           (cmds/resolve-remove-target remove-wts "feature/bar"))))
  (testing "detached worktree has no branch to delete"
    (is (= {:path "/Users/u/Projects/worktrees/wtr/loose"
            :branch nil}
           (cmds/resolve-remove-target remove-wts "loose")))))

(deftest resolve-remove-target-not-found
  (testing "returns nil when no worktree matches"
    (is (nil? (cmds/resolve-remove-target remove-wts "nope")))))
