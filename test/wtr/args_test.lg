(ns wtr.args-test
  (:require [test :refer [deftest is testing run-tests]]
            [wtr.args :as args]))

(deftest strip-runner-args-bundled-mode
  (testing "drops argv[0] (the binary path)"
    (is (= ["run" "feat-x" "npm" "test"]
           (args/strip-runner-args
             ["/x/bin/wtr" "run" "feat-x" "npm" "test"] false))))

  (testing "keeps a literal -- inside the user's command"
    (is (= ["run" "f" "git" "checkout" "--" "file"]
           (args/strip-runner-args
             ["/x/bin/wtr" "run" "f" "git" "checkout" "--" "file"] false)))))

(deftest strip-runner-args-dev-mode
  (testing "drops up to and including lgx's injected -- marker"
    (is (= ["run" "f" "npm" "test"]
           (args/strip-runner-args
             ["lg" "-source-paths" "X" "main.lg" "--" "run" "f" "npm" "test"]
             true))))

  (testing "strips only the marker, preserving a later -- in the command"
    (is (= ["run" "f" "git" "checkout" "--" "file"]
           (args/strip-runner-args
             ["lg" "main.lg" "--" "run" "f" "git" "checkout" "--" "file"]
             true)))))

(deftest strip-runner-args-inherited-env
  (testing "lgx-run? set but no -- marker (inherited LGX_RUN in a bundled
            binary) falls back to bundled stripping rather than dropping args"
    (is (= ["list"]
           (args/strip-runner-args ["/x/bin/wtr" "list"] true)))
    (is (= ["run" "feat-x" "npm" "test"]
           (args/strip-runner-args
             ["/x/bin/wtr" "run" "feat-x" "npm" "test"] true)))))
