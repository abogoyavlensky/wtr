(ns wtr.main
  (:require [clojure.string :as str]
            [os :as os]
            [tiny-cli.core :as cli]
            [wtr.args :as args]
            [wtr.commands :as cmds]
            [wtr.completion :as completion]))

(defn- version []
  (io/slurp (io/resource "VERSION")))

(def app
  {:name "wtr"
   :version (version)
   :doc "Small git worktree helper."
   :opts [{:key :base-dir
           :long "base-dir"
           :value? true
           :doc "Override base directory for worktrees."}]
   :footer (str "Run 'wtr help COMMAND' for more information on a command."
                "\nSee https://github.com/abogoyavlensky/wtr for more information.")
   :commands [{:name "list"
               :doc "List worktrees."
               :run cmds/list}
              {:name "create"
               :doc "Create a new worktree."
               :args [{:key :name
                       :doc "Worktree name (used for directory and branch)."}]
               :opts [{:key :from
                       :long "from"
                       :value? true
                       :doc "Create from specific branch or commit."}
                      {:key :sh
                       :long "sh"
                       :doc "Open an interactive shell in the new worktree."}]
               :run cmds/create}
              {:name "run"
               :doc "Run a command (or a shell) in a worktree."
               :args [{:key :name
                       :doc "Worktree name, or master/main for the main worktree."
                       :complete completion/worktree-name-candidates}]
               :variadic {:key :cmd
                          :doc "Command to run; omit to open a shell."}
               :run cmds/run}
              {:name "switch"
               :doc "Switch the main worktree to a worktree's branch (detached)."
               :args [{:key :name
                       :doc "Worktree name, or master/main to re-attach the main worktree."
                       :complete completion/worktree-name-candidates}]
               :run cmds/switch}
              {:name "remove"
               :doc "Remove a worktree and clean up its branch."
               :args [{:key :name
                       :doc "Worktree name to remove."
                       :complete completion/worktree-name-candidates}]
               :opts [{:key :force
                       :long "force"
                       :doc "Force removal of a dirty worktree and force-delete the branch."}]
               :run cmds/remove}
              {:name "config"
               :doc "Show the config file path and its content."
               :run cmds/config}]})

(defn- cli-argv [argv]
  "Application args, robust across dev (`lgx run`) and bundled-binary modes.
   Detects dev mode via LGX_RUN (set by `lgx run`) rather than sniffing for a
   `--`, which can collide with a `--` inside a user command (e.g. `run wt
   git checkout -- file`)."
  (args/strip-runner-args argv (not (str/blank? (os/getenv "LGX_RUN")))))

(defn- main []
  ;; tiny-cli provides the `completion` command and intercepts `__complete`
  ;; for the shell scripts; wtr only supplies worktree names via :complete.
  (cli/run! app (cli-argv os/args)))

; Top-level forms run during AOT compilation too. Guard so `lg -b` doesn't
; execute the CLI while bundling.
(when-not *compiling-aot*
  (main))
