(ns wtr.main
  (:require [os :as os]
            [clojure.string :as str]
            [tiny-cli.core :as cli]
            [wtr.commands :as cmds]))

(def app
  {:name "wtr"
   :version "0.1.0"
   :doc "Small git worktree helper."
   :commands [{:name "list"
               :doc "List worktrees."
               :run cmds/list}]})

(defn- cli-argv [argv]
  "Return args after the script path while developing, or CLI args in bundled mode."
  (let [tail (drop-while #(not (str/ends-with? % ".lg")) argv)]
    (or (seq (rest tail)) (rest argv))))

(defn- main []
  (cli/run! app (cli-argv os/args)))

; Top-level forms run during AOT compilation too. Guard so `lg -b` doesn't
; execute the CLI while bundling.
(when-not *compiling-aot* 
  (main))
