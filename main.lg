(ns wtr.main
  (:require [os :as os]
            [clojure.string :as str]
            [tiny-cli.core :as cli]
            [wtr.args :as args]
            [wtr.commands :as cmds]))

(def app
  {:name "wtr"
   :version "0.1.0"
   :doc "Small git worktree helper."
   :opts [{:key :base-dir
           :long "base-dir"
           :value? true
           :doc "Override base directory for worktrees."}]
   :footer (str "Run 'wtr help COMMAND' for more information on a command"
              "\nSee https://github.com/abogoyavlensky/wtr for more information.")
   :commands [{:name "list"
               :doc "List worktrees."
               :run cmds/list}
              {:name "create"
               :doc "Create a new worktree."
               :args [{:key :name
                       :doc "Worktree name (used for directory and branch)."}]
               :opts [{:key :from
                       :long "from"
                       :value? true
                       :doc "Create from specific branch or commit."}]
               :run cmds/create}
              {:name "run"
               :doc "Run a command (or a shell) in a worktree."
               :args [{:key :name
                       :doc "Worktree name, or master/main for the main worktree."}]
               :variadic {:key :cmd
                          :doc "Command to run; omit to open a shell."}
               :run cmds/run}]})

(defn- cli-argv [argv]
  "Application args, robust across dev (`lgx run`) and bundled-binary modes.
   Detects dev mode via LGX_RUN (set by `lgx run`) rather than sniffing for a
   `--`, which can collide with a `--` inside a user command (e.g. `run wt
   git checkout -- file`)."
  (args/strip-runner-args argv (not (str/blank? (os/getenv "LGX_RUN")))))

(defn- main []
  (cli/run! app (cli-argv os/args)))

; Top-level forms run during AOT compilation too. Guard so `lg -b` doesn't
; execute the CLI while bundling.
(when-not *compiling-aot* 
  (main))
