(ns wtr.commands
  (:refer-clojure :exclude [list remove])
  (:require [clojure.string :as str]
            [os :as os]
            [wtr.config :as config]
            [wtr.format :as fmt]
            [wtr.git :as git]))

(defn- error-exit
  "Prints \"Error: <msgs...>\" to stderr and exits 1. Callers must not include
   the \"Error:\" prefix in their message strings — this helper prepends it."
  [& msgs]
  (binding [*out* *err*]
    (apply println "Error:" msgs))
  (os/exit 1))

(defn basename
  "Last non-blank segment of a /-separated path."
  [path]
  (last (filter #(not (str/blank? %)) (str/split path "/"))))

(defn resolve-worktree-path
  "Resolve a worktree `name` to its absolute path against the live worktrees
   vector (from wtr.git/worktrees). `master`/`main` alias the main (first)
   worktree; otherwise the worktree whose path ends with `/<name>`. Matching by
   suffix (not just basename) handles namespaced names like `feature/bar`,
   whose worktree lives at `{base}/{project}/feature/bar`. Returns nil when
   nothing matches. Config-free: only resolves worktrees that exist."
  [wts name]
  (cond
    (or (= name "master") (= name "main"))
    (:path (first wts))

    :else
    (some (fn [w] (when (str/ends-with? (:path w) (str "/" name)) (:path w)))
          wts)))

(def direct-runner-script
  "cd \"$1\" || exit 1; shift; exec \"$@\"")

(def shell-command-runner-script
  "cd \"$1\" || exit 1; shift; \"$@\"")

(defn command-executable?
  "True when `cmd-name` resolves to an executable path from `dir`.
   Shell functions and aliases intentionally return false; those need the
   user's interactive shell. Shell builtins and keywords also return false
   because the direct runner uses `exec \"$@\"`, which needs a real executable."
  [dir cmd-name]
  (try
    (zero? (:exit (os/sh "sh" "-c"
                         (str "cd \"$2\" || exit 1; "
                              "case \"$1\" in "
                              "*/*) [ -x \"$1\" ] ;; "
                              "*) IFS=:; "
                              "for d in $PATH; do "
                              "[ -n \"$d\" ] || d=.; "
                              "[ -f \"$d/$1\" ] && [ -x \"$d/$1\" ] && exit 0; "
                              "done; "
                              "exit 1 ;; "
                              "esac")
                         "sh" cmd-name dir)))
    (catch Exception _ false)))

(def shell-builtin-stubs
  "Shell builtins that macOS also ships as standalone `/usr/bin` stub
   executables (see builtin(1)). They must run inside the user's shell so the
   builtin — not the inert stub — handles them; `exec`ing `/usr/bin/cd`, for
   instance, only changes a short-lived child's directory and affects nothing.
   Linux has no such stubs, so the PATH probe in `command-executable?` already
   routes these to the shell; this set keeps the behaviour consistent on macOS."
  #{"alias" "bg" "cd" "command" "fc" "fg" "getopts" "hash" "jobs"
    "read" "type" "ulimit" "umask" "unalias" "wait"})

(defn run-command-mode
  "Classify the trailing command for `wtr run`.
     []                    -> :interactive-shell
     executable command    -> :direct
     builtin/function/name -> :shell-command"
  [dir cmd]
  (cond
    (empty? cmd) :interactive-shell
    (shell-builtin-stubs (first cmd)) :shell-command
    (command-executable? dir (first cmd)) :direct
    :else :shell-command))

(defn run-exec-argv
  "Build the argv vector passed to `os/exec*` for a resolved run command."
  [dir shell mode cmd]
  (case mode
    :interactive-shell
    ["sh" "-c" direct-runner-script "sh" dir shell "-i"]

    :direct
    (vec (concat ["sh" "-c" direct-runner-script "sh" dir] cmd))

    :shell-command
    (vec (concat [shell "-ic" shell-command-runner-script
                  "wtr-shell" dir]
                 cmd))))

(defn shell-backed-run-mode?
  [mode]
  (or (= mode :interactive-shell)
      (= mode :shell-command)))

(defn- user-shell
  []
  (let [s (os/getenv "SHELL")]
    (if (str/blank? s) "/bin/sh" s)))

(defn- trust-mise-worktree!
  "Best-effort trust preflight for shell-backed modes. Ignore failures so
   users without mise, or with an older mise, still get the requested shell."
  [dir]
  (when (command-executable? dir "mise")
    (try
      (os/sh "mise" "trust" "--yes" "--all" "--cd" dir)
      (catch Exception _ nil))))

(defn resolve-switch-target
  "Map (worktrees `wts`, `name`) to a switch intent for `wtr switch`, or nil when
   no worktree matches.
     master|main          -> {:mode :reattach :ref name}
     a matching worktree  -> {:mode :detach :ref <branch|head> :label name
                              :sha <head>}
     otherwise            -> nil
   `master`/`main` are reserved tokens (re-attach the main worktree), checked
   before any worktree lookup, shadowing a worktree literally named that —
   consistent with `run`. For detach, :ref is the worktree's branch (with a
   leading `refs/heads/` stripped) so we land on the branch tip; a worktree that
   is itself detached (no :branch) falls back to its :head sha. :sha is the
   worktree's head, used only for the confirmation message (after
   `git switch --detach <branch>` HEAD equals the branch tip equals this head)."
  [wts name]
  (cond
    (or (= name "master") (= name "main"))
    {:mode :reattach
     :ref name}

    :else
    (when-let [w (some (fn [w] (when (str/ends-with? (:path w) (str "/" name)) w))
                       wts)]
      (let [branch (:branch w)
            ref (if (str/blank? (or branch ""))
                  (:head w)
                  (str/replace branch #"^refs/heads/" ""))]
        {:mode :detach
         :ref ref
         :label name
         :sha (:head w)}))))

(defn resolve-remove-target
  "Map (worktrees `wts`, `name`) to a remove intent, or nil when nothing
   matches. `master`/`main`, or any name resolving to the main (first) worktree,
   returns {:main? true}. A non-main worktree returns {:path <abs>
   :branch <branch|nil>}, with refs/heads/ stripped from attached branches."
  [wts name]
  (let [main-path (:path (first wts))]
    (cond
      (or (= name "master") (= name "main"))
      {:main? true}

      :else
      (when-let [w (some (fn [w] (when (str/ends-with? (:path w) (str "/" name)) w))
                         wts)]
        (if (= (:path w) main-path)
          {:main? true}
          (let [branch (:branch w)]
            {:path (:path w)
             :branch (when-not (str/blank? (or branch ""))
                       (str/replace branch #"^refs/heads/" ""))}))))))

(defn- first-nonblank-line
  [s fallback]
  (or (some (fn [line]
              (let [trimmed (str/replace (str/trim line) #"^error: " "")]
                (when-not (str/blank? trimmed) trimmed)))
            (str/split (or s "") #"\n"))
      fallback))

(defn main-return-branch
  "The branch token to advise the user to `wtr switch` back to, given the main
   worktree record `main-wt` (first of `git/worktrees`). Uses its current branch
   when the main worktree is attached (the common case — captured before we
   detach it); when it is already detached (no :branch), probes for a `main`
   branch, else falls back to `master`."
  [main-wt]
  (let [b (:branch main-wt)]
    (cond
      (not (str/blank? (or b ""))) (str/replace b #"^refs/heads/" "")
      (git/branch-exists? "main") "main"
      :else "master")))

(defn list
  "List worktrees."
  [_context]
  (try
    (let [wts (git/worktrees)
          cwd (os/cwd)]
      (println (fmt/render-list wts cwd)))
    (catch Exception e
      (let [stderr (or (:stderr (ex-data e)) (str e))]
        (binding [*out* *err*]
          (print stderr)))
      (os/exit 1))))

(defn create
  "Create a new worktree at {base-dir}/{project}/{name} on a new branch <name>."
  [{:keys [global args opts]}]
  (try
    (let [name (:name args)
          from-ref (:from opts)
          main-path (git/main-worktree-path)
          base-dir (config/ensure-config! (:base-dir global) main-path)
          project (basename main-path)
          wt-path (str base-dir "/" project "/" name)]

      (when (git/branch-exists? name)
        (error-exit (str "Branch '" name "' already exists")))
      (when (file-exists? wt-path)
        (error-exit (str "Directory already exists: " wt-path)))

      (git/create-worktree! wt-path name from-ref)

      (println "Created worktree at" wt-path)
      (if (str/blank? (or from-ref ""))
        (println "Branch:" name)
        (println "Branch:" name (str "(from " from-ref ")")))

      (when (:sh opts)
        ;; Same child-process hygiene as `run`: the shell is run by wtr, not
        ;; lgx, so clear any inherited LGX_RUN before exec'ing.
        (os/setenv "LGX_RUN" "")
        (trust-mise-worktree! wt-path)
        (os/exit (apply os/exec*
                        (run-exec-argv wt-path (user-shell)
                                       :interactive-shell nil)))))
    (catch Exception e
      (let [stderr (:stderr (ex-data e))]
        (binding [*out* *err*]
          (if stderr
            (print stderr)
            (println "Error:" (ex-message e)))))
      (os/exit 1))))

(defn run-in-dir!
  "Exec `cmd` in worktree `dir`, replacing the current process via `os/exec*`.
   `cmd` is a vector; an empty one opens an interactive shell. Clears LGX_RUN,
   classifies the command, runs the mise-trust preflight for shell-backed
   modes, then execs and exits with the child's status. Never returns."
  [dir cmd]
  ;; The child is run by wtr, not by lgx — clear any inherited LGX_RUN so a
  ;; bundled lgx-built tool we exec isn't fooled into dev-runner arg parsing.
  (os/setenv "LGX_RUN" "")
  (let [shell (user-shell)
        mode (run-command-mode dir cmd)
        argv (run-exec-argv dir shell mode cmd)]
    (when (shell-backed-run-mode? mode)
      (trust-mise-worktree! dir))
    (os/exit (apply os/exec* argv))))

(defn run
  "Run a command (or an interactive shell) in the named worktree.
   Resolves <name> against `git worktree list` (master/main → main worktree),
   then execs in that directory with inherited stdio, propagating the exit
   code. With no command, opens $SHELL (fallback /bin/sh). `os/exec*` cannot
   set a cwd, so we go through `sh -c` which cd's then execs the command via
   positional args (no quoting/injection risk)."
  [{:keys [args]}]
  (try
    (let [name (:name args)
          cmd (:cmd args)
          dir (resolve-worktree-path (git/worktrees) name)]
      (when-not dir
        (error-exit (str "Worktree not found: " name)))
      (run-in-dir! dir cmd))
    (catch Exception e
      (let [stderr (:stderr (ex-data e))]
        (binding [*out* *err*]
          (if stderr
            (print stderr)
            (println "Error:" (ex-message e)))))
      (os/exit 1))))

(defn switch!
  "Perform `wtr switch <name>` and return a result map — never prints or exits.
     {:ok? true  :message \"Switched main worktree to ...\"}
     {:ok? false :message \"<reason>\"}
   The CLI `switch` command and the dashboard both build on this."
  [name]
  (try
    (let [wts (git/worktrees)
          main (:path (first wts))
          target (resolve-switch-target wts name)]
      (if-not target
        {:ok? false
         :message (str "Worktree not found: " name)}
        (do
          (git/switch-ref! main (:ref target) (= :detach (:mode target)))
          {:ok? true
           :message (if (= :detach (:mode target))
                      (str "Switched main worktree to '" (:label target)
                           "' (detached at " (subs (:sha target) 0 7)
                           "). Run 'wtr switch " (main-return-branch (first wts))
                           "' to return.")
                      (str "Switched main worktree to " (:ref target)))})))
    (catch Exception e
      {:ok? false
       :message (first-nonblank-line (:stderr (ex-data e)) (ex-message e))})))

(defn switch
  "Switch the main worktree to a worktree's branch.
   `master`/`main` re-attach the main worktree to that branch; any other name
   detaches the main worktree at the matching worktree's branch tip, so its code
   can be read/built/run from the main project dir without claiming the branch."
  [{:keys [args]}]
  (let [res (switch! (:name args))]
    (if (:ok? res)
      (println (:message res))
      (error-exit (:message res)))))

(defn remove!
  "Perform a `wtr remove <name>` (force? picks -d vs -D) and return a result
   map — never prints or exits.
     {:ok? true  :removed? true  :message \"Removed worktree ...\"}
     {:ok? false :removed? false :message \"<reason>\"}   ; not found / main worktree
   The CLI `remove` command and the dashboard both build on this."
  [name force?]
  (try
    (let [wts (git/worktrees)
          main (:path (first wts))
          target (resolve-remove-target wts name)]
      (cond
        (nil? target)
        {:ok? false
         :removed? false
         :message (str "Worktree not found: " name)}

        (:main? target)
        {:ok? false
         :removed? false
         :message (str "Refusing to remove the main worktree: " name)}

        :else
        (do
          (git/remove-worktree! main (:path target) force?)
          (let [branch (:branch target)]
            {:ok? true
             :removed? true
             :message (if branch
                        (let [res (git/delete-branch! main branch force?)]
                          (if (zero? (:exit res))
                            (str "Removed worktree " (:path target)
                                 " and branch " branch ".")
                            (str "Removed worktree " (:path target)
                                 ". Kept branch '" branch "': "
                                 (first-nonblank-line (:err res)
                                                      "could not delete branch")
                                 " Re-run with --force to delete it.")))
                        (str "Removed worktree " (:path target) "."))}))))
    (catch Exception e
      {:ok? false
       :removed? false
       :message (first-nonblank-line (:stderr (ex-data e)) (ex-message e))})))

(defn remove
  "Remove a worktree and clean up its branch."
  [{:keys [args opts]}]
  (let [res (remove! (:name args) (:force opts))]
    (if (:ok? res)
      (println (:message res))
      (error-exit (:message res)))))

(defn config
  "Show the config file path and its content (read-only). When the file does
   not exist yet, shows the path and the would-be default base_dir instead."
  [_context]
  (try
    (let [path (config/config-path)]
      (if (file-exists? path)
        (println (config/render-config path (slurp path) nil))
        (println (config/render-config
                   path nil (config/default-base-dir (git/main-worktree-path))))))
    (catch Exception e
      (let [stderr (:stderr (ex-data e))]
        (binding [*out* *err*]
          (if stderr
            (print stderr)
            (println "Error:" (ex-message e)))))
      (os/exit 1))))
