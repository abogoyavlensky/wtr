(ns wtr.git
  (:require [os :as os]
            [clojure.string :as str]))

(defn- parse-record [lines]
  (reduce
   (fn [m line]
     (cond
       (str/starts-with? line "worktree ") (assoc m :path (subs line 9))
       (str/starts-with? line "HEAD ") (assoc m :head (subs line 5))
       (str/starts-with? line "branch ") (assoc m :branch (subs line 7))
       (= line "detached") (assoc m :detached? true)
       (= line "bare") (assoc m :bare? true)
       (str/starts-with? line "locked") (assoc m :locked? true)
       (str/starts-with? line "prunable") (assoc m :prunable? true)
       :else m))
   {:detached? false :bare? false :locked? false :prunable? false}
   lines))

(defn worktrees
  "Run `git worktree list --porcelain -z`, return a vector of maps:
   [{:path \"/abs/path\" :head \"sha\" :branch \"refs/heads/foo\"
     :detached? false :bare? false :locked? false :prunable? false}]
   First entry is always the main worktree.
   Throws ex-info on non-zero git exit; caller prints + exits."
  []
  (let [result (os/sh "git" "worktree" "list" "--porcelain" "-z")]
    (when-not (zero? (:exit result))
      (throw (ex-info "git worktree list failed" {:stderr (:err result)})))
    (let [output (:out result)
          records (str/split output #"\x00\x00")]
      (mapv (fn [rec]
              (let [lines (str/split rec #"\x00")]
                (parse-record lines)))
            (remove str/blank? records)))))

(defn main-worktree-path
  "Returns the absolute path to the main worktree (first entry of `worktrees`)."
  []
  (:path (first (worktrees))))

(defn branch-exists?
  "Returns true if a local branch with the given name exists."
  [name]
  (let [result (os/sh "git" "rev-parse" "--verify"
                      (str "refs/heads/" name))]
    (zero? (:exit result))))

(defn create-worktree!
  "Runs `git worktree add` to create a new worktree at `path` on a new branch
   `branch`. When `from-ref` is set, branches off that ref; otherwise off HEAD.
   Throws ex-info with git's stderr on non-zero exit."
  [path branch from-ref]
  (let [args (if (str/blank? (or from-ref ""))
               ["git" "worktree" "add" "-b" branch path]
               ["git" "worktree" "add" "-b" branch path from-ref])
        result (apply os/sh args)]
    (when-not (zero? (:exit result))
      (throw (ex-info "git worktree add failed"
                      {:stderr (:err result)
                       :stdout (:out result)})))
    result))
