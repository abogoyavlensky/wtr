(ns wtr.completion
  (:require [clojure.string :as str]
            [wtr.config :as config]
            [wtr.git :as git]))

(defn- basename [path]
  (last (filter #(not (str/blank? %)) (str/split path "/"))))

(defn worktree-names
  "Names of the non-main worktrees in a `wtr.git/worktrees` vector: the path
   with `base-prefix` (\"{base-dir}/{project}/\") stripped when it matches —
   preserving namespaced names like feature/bar — else the path's basename."
  [wts base-prefix]
  (mapv (fn [w]
          (let [path (:path w)]
            (if (and base-prefix (str/starts-with? path base-prefix))
              (subs path (count base-prefix))
              (basename path))))
        (rest wts)))

(defn default-branch-token
  "The single canonical completion token for the main worktree record `main-wt`
   (first of `git/worktrees`): always `main` or `master`, never a custom branch,
   since those are the only reserved aliases that resolve to the main worktree.
   Uses the worktree's own branch when it is `main`/`master`; otherwise (detached
   or on a custom branch) falls back to whichever exists as a local branch,
   preferring `main` — mirroring `wtr.commands/main-return-branch`."
  [main-wt]
  (let [branch (:branch main-wt)
        name (when-not (str/blank? (or branch ""))
               (str/replace branch #"^refs/heads/" ""))]
    (cond
      (= name "main") "main"
      (= name "master") "master"
      (git/branch-exists? "main") "main"
      :else "master")))

(defn- names-with-prefix
  "Non-main worktree names for the current repo, with the config base-dir prefix
   (\"{base-dir}/{project}/\") stripped where it matches. Shared by the
   worktree-name completion fns."
  [wts]
  (let [base (:base-dir (config/read-config))
        prefix (when-not (str/blank? (or base ""))
                 (str base "/"
                      (basename (:path (first wts)))
                      "/"))]
    (worktree-names wts prefix)))

(defn worktree-name-candidates
  "Completion candidates for a worktree-name positional on `run`/`switch`: the
   main worktree's default-branch token (`main` or `master`) plus the existing
   non-main worktree names, derived from `git/worktrees` and the config base-dir
   prefix. Used as a tiny-cli :complete fn — tiny-cli wraps __complete in
   try/catch, so a non-repo or bad-config state simply yields no candidates."
  [_ctx]
  (let [wts (git/worktrees)]
    (into [(default-branch-token (first wts))] (names-with-prefix wts))))

(defn removable-worktree-name-candidates
  "Completion candidates for `remove`'s worktree-name positional: only the
   non-main worktree names. `main`/`master` are deliberately omitted — the main
   worktree is protected from removal, so offering them would be misleading."
  [_ctx]
  (names-with-prefix (git/worktrees)))
