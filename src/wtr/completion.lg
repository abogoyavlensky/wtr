(ns wtr.completion
  (:require [clojure.string :as str]
            [wtr.config :as config]
            [wtr.git :as git]))

(defn- basename [path]
  (last (filter #(not (str/blank? %)) (str/split path "/"))))

(defn worktree-names
  "Names of the non-main worktrees in a `wtr.git/worktrees` vector: the path
   with `base-prefix` (\"{base-dir}/{project}/\") stripped when it matches —
   preserving namespaced names like feature/bar — else the path's basename."
  [wts base-prefix]
  (mapv (fn [w]
          (let [path (:path w)]
            (if (and base-prefix (str/starts-with? path base-prefix))
              (subs path (count base-prefix))
              (basename path))))
        (rest wts)))

(defn worktree-name-candidates
  "Completion candidates for a worktree-name positional (run/switch/remove):
   main/master plus the existing non-main worktree names, derived from
   `git/worktrees` and the config base-dir prefix. Used as a tiny-cli :complete
   fn — tiny-cli wraps __complete in try/catch, so a non-repo or bad-config
   state simply yields no candidates."
  [_ctx]
  (let [wts (git/worktrees)
        base (:base-dir (config/read-config))
        prefix (when-not (str/blank? (or base ""))
                 (str base "/"
                      (basename (:path (first wts)))
                      "/"))]
    (into ["main" "master"] (worktree-names wts prefix))))
