(ns wtr.main
  (:require [tiny-cli.core :as cli]
            [clojure.string :as str]))

(defn create!
  [context]
  (prn "Create!"))

(def app
  {:name "wtr"
   :version "0.1.0"
   :doc "Small git worktree helper."
   :opts [{:key :verbose?
           :short "v"
           :long "verbose"
           :doc "Print executed commands."}]
   :commands [{:name "create"
               :doc "Create a worktree for a branch."
               :args [{:key :branch
                       :doc "Branch name."}]
               :opts [{:key :base
                       :short "b"
                       :long "base"
                       :value? true
                       :default "master"
                       :doc "Base branch."}]
               :run create!}]})

(defn- script-path? [s]
  (and (string? s)
       (str/ends-with? s ".lg")))

(defn- script-argv [args]
  (loop [xs args]
    (cond
      (empty? xs) []
      (script-path? (first xs)) (vec (rest xs))
      :else (recur (rest xs)))))

(defn- main [argv]
  (let [argv (or (seq argv) (vec (rest os/args)))]
    (cli/run! app argv))
  (println "Hello, WTR!"))


; Top-level forms run during AOT compilation too. Guard so `lg -b` doesn't
; execute the CLI while bundling.
(when-not *compiling-aot* 
  (main (script-argv os/args)))
