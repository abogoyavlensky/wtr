(ns wtr.args)

(defn strip-runner-args
  "Return the application args from a raw argv.
   - dev (under `lgx run`): drop everything up to and including lgx's injected
     `--` marker.
   - bundled binary: drop argv[0] (the program name).
   We treat argv as dev-runner args only when BOTH `lgx-run?` (the caller's
   LGX_RUN check) is set AND lgx's `--` marker is actually present. That guard
   matters because env vars are inherited: a bundled binary launched from a
   process that exported `LGX_RUN=1` would otherwise drop its real arguments.
   Keeping the bundled path the default also preserves a literal `--` inside a
   user command (e.g. `run wt git checkout -- file`)."
  [argv lgx-run?]
  (if (and lgx-run? (some #(= % "--") argv))
    (vec (rest (drop-while #(not (= % "--")) argv)))
    (vec (rest argv))))
