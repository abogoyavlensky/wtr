(ns wtr.dashboard
  (:require [term]
            [tiny-tui.core :as tui]
            [wtr.commands :as cmds]
            [wtr.completion :as completion]
            [wtr.git :as git]))

(defn interactive?
  "True when a terminal is attached (stdin/stdout), so the inline TUI can run.
   tiny-tui reports no size off a tty and throws if asked to render there."
  []
  (some? (term/size)))

(def ^:private run-action
  {:id :run
   :key "r"
   :label "run"})

(def ^:private switch-action
  {:id :switch
   :key "s"
   :label "switch"})

(defn result->intent
  "Map a tiny-tui select result to a dashboard intent: [:run name] on enter,
   [<action> name] for an action key (:run or :switch), or :cancel."
  [result]
  (case (:type result)
    :select [:run (:item result)]
    :action [(:action result) (:item result)]
    ;; :cancel, and anything unexpected
    :cancel))

(defn- run-name!
  "Open a shell in the worktree named `name`, replacing the process."
  [name]
  (cmds/run-in-dir! (cmds/resolve-worktree-path (git/worktrees) name) []))

(defn- switch-name!
  "Re-point the main worktree at the worktree named `name` (via `wtr switch`)."
  [name]
  (cmds/switch {:args {:name name}}))

(defn pick!
  "Show the full-screen worktree picker and act on the choice. `opts` are
   merged into tiny-tui.core/select — tests inject :items, :screen false, a
   scripted :read-key-fn, and a :render-fn; :run-fn and :switch-fn override the
   run/switch actions (defaulting to run-name!/switch-name!). Candidates are
   the tab-completion worktree names unless :items is supplied. Returns nil."
  ([] (pick! {}))
  ([opts]
   (let [run-fn (:run-fn opts run-name!)
         switch-fn (:switch-fn opts switch-name!)
         base {:title "Worktrees"
               :item->text identity
               :actions [run-action switch-action]}
         base (if (contains? opts :items)
                base
                (assoc base :items (completion/worktree-name-candidates nil)))
         result (tui/select (merge base (dissoc opts :run-fn :switch-fn)))
         intent (result->intent result)]
     (when-not (= :cancel intent)
       (case (first intent)
         :run (run-fn (second intent))
         :switch (switch-fn (second intent))))
     nil)))

(defn show!
  "Root handler for a bare `wtr` invocation. On an interactive terminal, shows
   the full-screen worktree dashboard; otherwise (piped/redirected) prints the
   static worktree list. Any TUI failure also falls back to the list."
  [context]
  (if (interactive?)
    (try
      (pick!)
      (catch Exception _ (cmds/list context)))
    (cmds/list context)))
