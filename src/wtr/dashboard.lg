(ns wtr.dashboard
  (:require [clojure.string :as str]
            [term]
            [tiny-tui.core :as tui]
            [wtr.commands :as cmds]
            [wtr.completion :as completion]
            [wtr.git :as git]))

(defn interactive?
  "True when a terminal is attached (stdin/stdout), so the full-screen TUI can
   run. tiny-tui reports no size off a tty and throws if asked to render there."
  []
  (some? (term/size)))

(def ^:private create-action
  ;; :returns? exits select so we can prompt for a name, create the worktree,
  ;; then open a shell in it — all outside select's raw-mode span.
  {:id :create
   :key "c"
   :label "create"
   :returns? true})

(def ^:private switch-action
  {:id :switch
   :key "s"
   :label "switch"})

(def ^:private remove-action
  {:id :remove
   :key "d"
   :label "remove"
   :destructive? true
   :confirm-title "Remove worktree?"
   ;; Deliberately does not promise branch deletion: `wtr remove` does a safe
   ;; delete (unmerged branches are kept, detached worktrees have none). What
   ;; actually happened is reported afterward in the status line.
   :confirm-message (fn [name] (str "Remove worktree '" name "'?"))})

(defn- run-name!
  "Open a shell in the worktree named `name`, replacing the process."
  [name]
  (cmds/run-in-dir! (cmds/resolve-worktree-path (git/worktrees) name) []))

(defn- on-switch
  "tiny-tui :on-action handler for `s`: switch the main worktree to the
   highlighted one, showing the result as a status line (the list is unchanged)."
  [event]
  (let [res (cmds/switch! (:item event))]
    {:status (:message res)}))

(defn- on-remove
  "tiny-tui :on-action handler for `d` (after its confirmation): safely remove
   the highlighted worktree. On a real removal, refresh the list so the row
   disappears; either way show the result as a status line — including the
   graceful refusal when the target is the main worktree."
  [event]
  (let [res (cmds/remove! (:item event) false)]
    (if (:removed? res)
      {:items (completion/worktree-name-candidates nil)
       :status (:message res)}
      {:status (:message res)})))

(defn- create-input
  "Prompt for a new worktree name, rejecting blank and existing-branch names
   inline. Returns the entered name, or nil on cancel."
  []
  (tui/input {:title "New worktree name"
              :placeholder "name"
              :validate (fn [text]
                          (cond
                            (str/blank? text) "Name can't be empty"
                            (git/branch-exists? text)
                            (str "Branch '" text "' already exists")
                            :else nil))}))

(defn- create-name!
  "Prompt for a name and create the worktree under `base-dir` (the --base-dir
   override, or nil for the configured base). Returns a map:
     {:name <new-name>}  on success — the dashboard opens a shell there,
     {:status <error>}   on a post-validation failure — shown as a status line,
     {}                  on cancel."
  [base-dir]
  (if-let [name (create-input)]
    (let [res (cmds/create! name nil base-dir)]
      (if (:ok? res)
        {:name (:name res)}
        {:status (:message res)}))
    {}))

(defn pick!
  "Show the full-screen worktree manager and act on the choice. `enter` opens a
   shell in the highlighted worktree (exiting the manager); `s`/`d` switch and
   remove in place via tiny-tui's :on-action; `c` leaves select to prompt for a
   name, creates a worktree, and opens a shell in it (like `enter`). `opts` are merged into
   tiny-tui.core/select — tests inject :items, :screen false, a scripted
   :read-key-fn, and a :render-fn; :run-fn, :switch-fn, :remove-fn, and
   :create-fn override the handlers (defaulting to
   run-name!/on-switch/on-remove/create-name!). Candidates are the tab-completion
   worktree names unless :items is supplied. Returns nil."
  ([] (pick! {}))
  ([opts]
   (let [run-fn (:run-fn opts run-name!)
         switch-fn (:switch-fn opts on-switch)
         remove-fn (:remove-fn opts on-remove)
         create-fn (:create-fn opts (fn [] (create-name! (:base-dir opts))))
         on-action (fn [event]
                     (case (:action event)
                       :switch (switch-fn event)
                       :remove (remove-fn event)))
         select-opts (dissoc opts :run-fn :switch-fn :remove-fn :create-fn
                             :base-dir)]
     (loop [status nil]
       (let [base {:title "Worktrees"
                   :item->text identity
                   :actions [create-action switch-action remove-action]
                   :on-action on-action
                   :status status}
             base (if (contains? opts :items)
                    base
                    (assoc base :items (completion/worktree-name-candidates nil)))
             result (tui/select (merge base select-opts))]
         (cond
           (= :select (:type result))
           (run-fn (:item result))

           (and (= :action (:type result)) (= :create (:action result)))
           (let [r (create-fn)]
             (if (:name r)
               (run-fn (:name r))     ; created → open a shell (execs, never returns)
               (recur (:status r))))  ; failure → status; cancel → nil (clean re-entry)

           :else nil))))))

(defn show!
  "Root handler for a bare `wtr` invocation. On an interactive terminal, shows
   the full-screen worktree manager; otherwise (piped/redirected) prints the
   static worktree list. Any TUI failure also falls back to the list."
  [context]
  (if (interactive?)
    (try
      (pick! {:base-dir (:base-dir (:global context))})
      (catch Exception _ (cmds/list context)))
    (cmds/list context)))
