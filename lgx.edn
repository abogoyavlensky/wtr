{:paths ["src"]
 :resource-paths ["resources"]
 :main "main.lg"
 :targets {:bin {:out "bin/wtr"}}
 :lg-version "1.11.1"
 :deps {tiny-cli {:local/root "../tiny-cli"
                  ;; Dev-pinned to the local checkout for the root-command
                  ;; handler work. Restore a published ref before release:
                  ;; :git/url "https://github.com/abogoyavlensky/tiny-cli"
                  ;; :git/tag "v0.2.0"
                  }
        tiny-tui {:local/root "../tiny-tui"
                  ;; Dev-pinned to the local checkout for the dashboard create
                  ;; action (:cursor-item / :returns?). Restore a published ref
                  ;; before release:
                  ;; :git/url "https://github.com/abogoyavlensky/tiny-tui"
                  ;; :git/sha "53ea48411f45a78a09d7fe215d32530568fe5ce0"
                  }}
 :tasks {fmt {:doc "Format source files (available actions: fix, check; default: fix)"
              :args [{:name :action
                      :type [:enum "fix" "check"]
                      :default "fix"}]
              :do [{:sh "cljfmt {{action}}"}]}

         lint {:doc "Lint source files"
               :do [{:sh "find src test -type f -name '*.lg' -print0 | xargs -0 clj-kondo --lint"}]}

         check {:doc "Run all checks"
                 :do [{:sh "lgx fmt"}
                      {:sh "lgx lint"} 
                      {:sh "lgx test"}]}

         release {:doc "Release a new version"
                  :extra-paths ["scripts"]
                  :do [{:run "scripts/tag.lg"}
                       {:sh "git push --tags"}]}}}
